# Server-only variables used by Next.js route handlers. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# Optional; defaults to the current app origin plus /login.
OAUTH_LOGIN_URL=https://your-domain.example/login
