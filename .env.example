# Server-only variables used by Next.js route handlers. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Zyqwax ID <no-reply@your-domain.example>
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Optional; defaults to the current app origin plus /login.
OAUTH_LOGIN_URL=https://your-domain.example/login
# OAuth client_id of the Developer Portal app registered in the admin panel.
DEVELOPER_PORTAL_CLIENT_ID=portal-client-id
