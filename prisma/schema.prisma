generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Merkezi kimlik bilgilerini tutar; id, bağlı uygulamaların kendi veritabanlarında kullanacağı tek ortak UUID anahtardır.
model User {
  id                      String                @id @default(uuid())
  email                   String                @unique
  username                String                @unique
  passwordHash            String
  name                    String?
  avatarUrl               String?
  avatarPublicId          String?
  usernameChangedAt       DateTime?
  emailChangedAt          DateTime?
  nameChangedAt           DateTime?
  avatarChangeCount       Int                   @default(0)
  avatarChangeWindowStart DateTime?
  emailVerified           Boolean               @default(false)
  isActive                Boolean               @default(true)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  refreshTokens           RefreshToken[]
  verificationTokens      VerificationToken[]
  loginHistories          LoginHistory[]
  authorizationCodes      AuthorizationCode[]
  consentRequests         OAuthConsentRequest[]
  sentRequests            FriendRequest[]       @relation("SentRequests")
  receivedRequests        FriendRequest[]       @relation("ReceivedRequests")
  friendshipsAsA          Friendship[]          @relation("FriendshipsAsA")
  friendshipsAsB          Friendship[]          @relation("FriendshipsAsB")
  blocksSent              Block[]               @relation("BlocksSent")
  blocksReceived          Block[]               @relation("BlocksReceived")
  roles                   UserRoleAssignment[]
}

// Görünen adı yalnızca yönetim arayüzü içindir; yetki kontrolünde kullanılmaz.
model UserRole {
  id          String               @id
  displayName String
  users       UserRoleAssignment[]
  permissions RolePermission[]
}

// Kullanıcıların birden fazla rol alabilmesi için bağlantı tablosu.
model UserRoleAssignment {
  userId String
  roleId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   UserRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// Makine tarafından kontrol edilen izin tanımı. tag benzersiz ve sabit API sözleşmesidir.
model Permission {
  id          String           @id
  tag         String           @unique
  displayName String
  roles       RolePermission[]
}

// Roller ile izinler arasındaki çoktan çoğa bağlantı.
model RolePermission {
  roleId       String
  permissionId String
  role         UserRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// SSO'ya bağlanan uygulama kayıtlarını ve gizli anahtar özetlerini tutar; id JWT aud claim'i için kullanılabilir.
model App {
  id                 String                @id @default(uuid())
  clientId           String                @unique @default(uuid())
  name               String
  secretKeyHash      String
  redirectUris       String[]
  allowedOrigins     String[]
  createdAt          DateTime              @default(now())
  refreshTokens      RefreshToken[]
  authorizationCodes AuthorizationCode[]
  consentRequests    OAuthConsentRequest[]
}

// Kullanıcı-uygulama oturumlarını temsil eder; düz token yerine yalnızca token özeti saklanır.
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  appId     String?
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Kullanıcı silinince oturum kayıtları anlamsız kalır; bu nedenle User ilişkisi Cascade'dir.
  app       App?     @relation(fields: [appId], references: [id], onDelete: Cascade)
  // App silinince yalnızca o uygulamaya ait oturumların da silinmesi güvenlidir.
}

// E-posta doğrulama ve parola sıfırlama işlemleri için süreli, tek kullanımlık token özetlerini tutar.
model VerificationToken {
  id        String                @id @default(uuid())
  tokenHash String                @unique
  userId    String
  type      VerificationTokenType
  expiresAt DateTime
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Kullanıcı silinince doğrulama/parola sıfırlama tokenlarının da geçersiz olması için Cascade kullanılır.
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Başarılı ve başarısız giriş denemelerini denetim amacıyla saklar.
model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  ipAddress String
  userAgent String
  success   Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Kısa ömürlü OAuth authorization code özetlerini ve PKCE bağlamını tutar.
model AuthorizationCode {
  id                  String   @id @default(uuid())
  codeHash            String   @unique
  userId              String
  appId               String
  redirectUri         String
  scope               String?  @default("profile email")
  codeChallenge       String
  codeChallengeMethod String   @default("S256")
  expiresAt           DateTime
  used                Boolean  @default(false)
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app                 App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, used, expiresAt])
}

// Kullanıcının OAuth yetkilendirme onayını bekleyen, kısa ömürlü tek kullanımlık istek.
model OAuthConsentRequest {
  id                  String   @id @default(uuid())
  tokenHash           String   @unique
  userId              String
  appId               String
  redirectUri         String
  scope               String
  state               String?
  codeChallenge       String
  codeChallengeMethod String   @default("S256")
  expiresAt           DateTime
  used                Boolean  @default(false)
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app                 App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([userId, used, expiresAt])
}

enum FriendRequestStatus {
  PENDING
  DECLINED
  ACCEPTED // kabul edilince Friendship oluşur, bu kayıt geçmiş amaçlı kalır
}

model FriendRequest {
  id          String              @id @default(uuid())
  senderId    String
  receiverId  String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  sender   User @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId]) // aynı yöne tekrar istek atılamaz
  @@index([receiverId, status]) // "bana gelen bekleyen istekler" sorgusu için
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String // KURAL: her zaman userAId < userBId (uuid string karşılaştırması)
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipsAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipsAsB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId]) // userA zaten unique index'in parçası, userB için ayrı index gerekir
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksSent", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
